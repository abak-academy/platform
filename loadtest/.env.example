# PostgreSQL target used only by the seed command.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=abak_loadtest
PGUSER=postgres
PGPASSWORD=replace-with-loadtest-db-password
CONFIRM_DB=abak_loadtest

# Existing non-production exam and synthetic account settings.
EXAM_ID=00000000-0000-0000-0000-000000000000
RUN_ID=smoke_20260830
USERS=1
LOADTEST_PASSWORD=replace-with-a-test-only-password

# k6 target and workload.
BASE_URL=https://loadtest.example.com/api/v1
NON_PRODUCTION_CONFIRM=loadtest
LOGIN_SPREAD_SECONDS=0
ANSWER_INTERVAL_SECONDS=0
ANSWER_JITTER_SECONDS=0
SAVE_RETRIES=3
MAX_QUESTIONS=0
SUBMIT_AT_SECONDS=0
MAX_DURATION=2h
REQUIRES_CHECKIN=false

# Optional latency thresholds in milliseconds.
LOGIN_P95_MS=1000
START_P95_MS=1500
AUTOSAVE_P95_MS=300
RECONNECT_P95_MS=1500
SUBMIT_P95_MS=1500

# Optional. Defaults to RUN_ID-USERS when empty.
REPORT_NAME=
