      "targets": [
        { "refId": "A", "expr": "{env=~\"$env\", service=\"worker\"} | json | msg=\"outbox event claimed\"" }
      ],
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 109 }
    }
