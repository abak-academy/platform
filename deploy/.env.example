# Hand-placed on the box (gitignored). On vm-app this file lives at the ROOT of
# the deploy dir — /home/<deploy-user>/abak-app/.env, next to app-production.yaml (the
# hand-ported fork of deploy/compose/production.yml) — not at deploy/.env.
# Compose resolves ${...} from it when run from that directory; pass --env-file
# explicitly to be safe. Both manifests share this same file and IMAGE_TAG.
#
# CAUTION: `docker compose config` interpolates every ${...} — its output
# contains these values in cleartext. Redact (--no-interpolate, or grep the
# variable NAMES only) before sharing/pasting. See
# docs/runbooks/monitoring-deployment.md §6.

# Commit SHA of the images to run — must match a pushed image tag
# (GHCR for staging, Artifact Registry for prod). Never 'latest'.
IMAGE_TAG=

# Postgres container credentials — staging only. Must match the database_url
# in secrets/staging-secrets.yaml (host = postgres, port = 5432). Prod has no
# postgres container (native on vm-db), so these are unused by
# compose/production.yml.
POSTGRES_USER=akademi
POSTGRES_PASSWORD=
POSTGRES_DB=akademi

# Grafana Cloud (issue #98) — production.yml only. All six values come from
# the Grafana Cloud portal: stack details page shows the Remote Write and Loki
# endpoints; API keys are created under Security > Access policies/tokens
# (create one token, use it for both pipelines). Full walkthrough:
# docs/runbooks/monitoring-deployment.md.
#
#   Prometheus remote write:
#     GRAFANA_CLOUD_PROM_URL          FULL push endpoint incl. path — e.g.
#                                     https://prometheus-prod-xx-xxx.grafana.net/api/prom/push
#                                     (bare host 404s; /api/prom is the query
#                                     endpoint, not for writes)
#     GRAFANA_CLOUD_PROM_INSTANCE_ID  numeric instance/user id
#     GRAFANA_CLOUD_PROM_API_KEY      the token
#   Loki push:
#     GRAFANA_CLOUD_LOKI_URL          e.g. https://logs-prod-xxx.grafana.net/loki/api/v1/push
#     GRAFANA_CLOUD_LOKI_TENANT_ID    numeric tenant id
#     GRAFANA_CLOUD_LOKI_API_KEY      the token
#
# PgBouncer exporter address — defaults to vm-db's internal IP; override only
# if the exporter listens elsewhere.
PGBOUNCER_EXPORTER_ADDRESS=10.20.0.10:9127
